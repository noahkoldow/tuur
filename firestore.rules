rules_version = '2';
// Default deny. Server-owned data (areas, places, pois, entitlements, credits, ...) is written only by
// Cloud Functions via the Admin SDK, which bypasses these rules. Spec 6.4: users/{uid}/entitlements is
// never client-writable.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /areas/{id} { allow read: if signedIn(); }
    match /places/{id} { allow read: if signedIn(); }

    match /pois/{id} {
      allow read: if signedIn() && (resource.data.hidden == false || isAdmin());
    }

    // Tours are readable while not locked by an admin (geometry and texts only; content access is checked in getNarration).
    match /tours/{id} {
      allow read: if signedIn() && (resource.data.locked == false || isAdmin());
    }

    // Only the `public` config doc (feature flags, non-sensitive limits) is client-readable.
    match /config/{doc} {
      allow read: if signedIn() && (doc == 'public' || isAdmin());
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['language', 'interests', 'narrationFrequency', 'voice', 'createdAt', 'consents'])
        && (!('language' in request.resource.data) || request.resource.data.language in ['de', 'en'])
        && (!('interests' in request.resource.data) || (request.resource.data.interests is list && request.resource.data.interests.size() <= 8));
      allow delete: if false; // deletion runs through the `deleteAccount` function

      match /entitlements/{id} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
      // Planned routes are created by `composePlannedRoute`; the owner may read them.
      match /sessions/{id} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
      match /credits/{id} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
