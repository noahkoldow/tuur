rules_version = '2';
// Phase 0 baseline: deny everything. Collection rules are added per phase (see docs/PROGRESS.md).
// Invariant (spec 6.4): users/{uid}/entitlements is never client-writable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
