{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.12.0",
      "pnpm": "10.33.0",
      "env": { "EXPO_PUBLIC_BACKEND": "firebase" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_USE_EMULATORS": "false" },
      "ios": { "simulator": true }
    },
    "emulator": {
      "extends": "development",
      "env": { "EXPO_PUBLIC_USE_EMULATORS": "true", "EXPO_PUBLIC_EMULATOR_HOST": "10.0.2.2" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_USE_EMULATORS": "false" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6817677603" },
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
