rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Shared narration audio (MP3). Written only by Cloud Functions; readable by signed-in users
    // (the client resolves a download URL via the Storage SDK). Blocked audio is deleted server-side.
    match /narrations/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Grounded narrations are per-user (Google terms: display only to the requesting end user).
    match /narrations-grounded/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
