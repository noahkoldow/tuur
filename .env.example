# Public client values: apps/mobile/.env.local or apps/web/.env.local. Never commit real values.
# Server params: functions/deploy/.env.local; local secret keys: functions/deploy/.secret.local.
# Production secrets: firebase functions:secrets:set <NAME> (one secret per command).
# Providers default to "mock" so everything runs locally against the emulators without any key.
TUUR_LLM_PROVIDER=mock        # mock | gemini
TUUR_TTS_PROVIDER=mock        # mock | gemini | live (Gemini + optional OpenAI)
TUUR_POI_PROVIDER=mock        # mock | live
TUUR_ROUTING_PROVIDER=mock    # mock | openrouteservice
ORS_URL=https://api.heigit.org/openrouteservice
TUUR_GEOCODING_PROVIDER=mock  # mock | nominatim | pelias
TUUR_PAYMENTS_PROVIDER=mock   # mock | stripe (partner billing)
TUUR_USER_AGENT=
TUUR_WEB_BASE_URL=https://tuur.app
NOMINATIM_URL=
# Pelias shares the server-only ORS_API_KEY and uses cached coarse reverse geocoding.
PELIAS_URL=https://api.heigit.org/pelias
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Optional paid Overspan: https://api.overspan.dev/api/interpreter (server-only bearer key below).
# Activate only after subscription/key setup and binding that secret to the POI ingestion functions.

# Secrets (Firebase defineSecret in production)
GEMINI_API_KEY=
OPENAI_API_KEY=
ORS_API_KEY=
# Optional, required only for the canonical Overspan endpoint above; never use EXPO_PUBLIC_/NEXT_PUBLIC_.
OVERPASS_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Server-only V2 credential; never put it in EXPO_PUBLIC_* or a browser bundle.
REVENUECAT_API_V2_KEY=
# V2 API identifier includes the proj prefix (not the shorter dashboard identifier).
REVENUECAT_PROJECT_ID=
# Server-side binding: the full rewarded ad unit ID allowed to grant rewards after Google signature checks.
TUUR_ADMOB_REWARDED_UNIT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REDEMPTION_TOKEN_SECRET=
MAPTILER_KEY= # Optional existing key; web maps default to free OSM/OpenFreeMap.

# Client (public) config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tuur-prod
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tuur-prod.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Web production only: registered Firebase App Check reCAPTCHA v3 site key.
EXPO_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
EXPO_PUBLIC_BACKEND=demo
EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_FUNCTIONS_REGION=europe-west1
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tuur-prod
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tuur-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Partner/admin web: Firebase App Check reCAPTCHA v3 site key registered for the deployed domain.
# Required for production callables; NEXT_PUBLIC_* values are fixed at build time.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_FUNCTIONS_REGION=europe-west1
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
# server side of the web app (invite preview, legal pages)
FUNCTIONS_BASE_URL=
WEB_BASE_URL=https://tuur.app
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_REGISTER=
OPERATOR_VAT_ID=
OPERATOR_REPRESENTATIVE=
OPERATOR_PRIVACY_EMAIL=
OPERATOR_SUPERVISORY_AUTHORITY=

# Mobile purchases/ads (public identifiers; not secrets). Defaults to Google test ads when unset.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT=
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# Native builds: explicit configuration checked by EAS after install (no preview bypasses).
GOOGLE_SERVICES_INFO_PLIST=
GOOGLE_SERVICES_JSON=
GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAPTILER_KEY=
# Empty above: online tuur style on OpenFreeMap, no account/key required.
# Only set to a style whose tiles/glyphs permit offline downloads. It also becomes the displayed native style.
# Never use the public OpenFreeMap/OSM/demo endpoints for offline prefetching without provider permission.
EXPO_PUBLIC_OFFLINE_MAP_STYLE_URL=
EXPO_PUBLIC_WEB_BASE_URL=https://tuur.app
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_OPERATOR_NAME=
EXPO_PUBLIC_OPERATOR_ADDRESS=
EXPO_PUBLIC_OPERATOR_EMAIL=
EXPO_PUBLIC_OPERATOR_REPRESENTATIVE=
EXPO_PUBLIC_OPERATOR_PRIVACY_EMAIL=
EXPO_PUBLIC_OPERATOR_SUPERVISORY_AUTHORITY=

# TestFlight only: a separate Firebase project, including its matching native Firebase files.
EXPO_PUBLIC_BETA_FIREBASE_PROJECT_ID=
# Set these on that beta backend, never on tuur-prod.
TUUR_DEPLOYMENT_ENV=production
TUUR_BETA_FIREBASE_PROJECT_ID=
TUUR_ALLOW_SANDBOX=false
# Optional dedicated runtime identities (service-account emails); empty keeps the platform default.
# The beta uses separate identities: health needs no project roles; callbacks need Firestore/Auth access.
TUUR_HEALTH_SERVICE_ACCOUNT=
TUUR_REVENUECAT_SERVICE_ACCOUNT=
TUUR_ADMOB_SERVICE_ACCOUNT=
TUUR_CORE_SERVICE_ACCOUNT=
TUUR_AI_SERVICE_ACCOUNT=
# Beta only: imported, locked OSM snapshot tiles. Leave empty for ordinary live ingestion.
TUUR_BETA_SNAPSHOT_TILES=
